# ---------------------------------------------------------------------------
# Durga Puja Global Connect - backend configuration
#
#   cd backend
#   copy .env.example .env
#
# Never expose any value in this file to the React app. The frontend only ever
# learns the API Gateway URL (frontend/.env -> VITE_API_URL).
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PostgreSQL / Prisma
#
# NOTE: this machine's PostgreSQL 18 listens on port 5000, not the default
# 5432 (verified in postgresql.conf). Change the port here if yours differs.
#
# >>> ACTION REQUIRED: replace CHANGE_ME with your `postgres` password. <<<
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5000/durga_puja_gs?schema=public"

# ---------------------------------------------------------------------------
# API Gateway
#
# The spec assigns the gateway port 5000, but PostgreSQL already occupies 5000
# on this machine, so the gateway defaults to 5050 instead.
# ---------------------------------------------------------------------------
GATEWAY_PORT=5050
CORS_ORIGINS=http://localhost:5173
SWAGGER_PATH=api/docs
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Microservice TCP transport (internal only - never reachable by the browser)
# ---------------------------------------------------------------------------
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=5001

USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=5002

REGISTRATION_SERVICE_HOST=localhost
REGISTRATION_SERVICE_PORT=5003

CONTENT_SERVICE_HOST=localhost
CONTENT_SERVICE_PORT=5004

GALLERY_SERVICE_HOST=localhost
GALLERY_SERVICE_PORT=5005

ATLAS_SERVICE_HOST=localhost
ATLAS_SERVICE_PORT=5006

EVENTS_SERVICE_HOST=localhost
EVENTS_SERVICE_PORT=5007

NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_PORT=5008

# ---------------------------------------------------------------------------
# JWT
#
# Generate real secrets before any non-local use:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-insecure-access-secret-change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=dev-only-insecure-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=durga-puja-gs
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Auth policy
# ---------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# Mail (notification-service). MAIL_DRIVER=log prints instead of sending.
# ---------------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@durgapujaglobalconnect.in
MAIL_FROM_NAME="Durga Puja Global Connect"

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
SEED_PASSWORD=Password123!
