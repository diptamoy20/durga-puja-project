// ===========================================================================
// Content / CMS
// ===========================================================================

model Article {
  id            Int     @id @default(autoincrement())
  subcategoryId Int     @map("subcategory_id")
  title         String  @db.VarChar(220)
  slug          String  @unique @db.VarChar(240)
  excerpt       String? @db.Text
  content       String  @db.Text
  featuredImage String? @map("featured_image") @db.VarChar(500)
  authorId      Int?    @map("author_id")

  seoTitle       String? @map("seo_title") @db.VarChar(255)
  seoDescription String? @map("seo_description") @db.Text
  seoKeywords    String? @map("seo_keywords") @db.VarChar(500)

  status        ArticleStatus @default(DRAFT)
  isFeatured    Boolean       @default(false) @map("is_featured")
  allowComments Boolean       @default(false) @map("allow_comments")

  scheduledAt DateTime? @map("scheduled_at")
  publishedAt DateTime? @map("published_at")

  submittedForReviewById Int?      @map("submitted_for_review_by")
  submittedForReviewAt   DateTime? @map("submitted_for_review_at")
  reviewedById           Int?      @map("reviewed_by")
  reviewedAt             DateTime? @map("reviewed_at")
  reviewComment          String?   @map("review_comment") @db.Text
  approvedById           Int?      @map("approved_by")
  approvedAt             DateTime? @map("approved_at")
  rejectedById           Int?      @map("rejected_by")
  rejectedAt             DateTime? @map("rejected_at")
  rejectionReason        String?   @map("rejection_reason") @db.Text

  createdById Int?      @map("created_by")
  updatedById Int?      @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  /// RESTRICT preserves the original behaviour: a subcategory cannot be
  /// deleted while articles still reference it.
  subcategory        Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  author             User?       @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  submittedForReviewBy User?     @relation("ArticleSubmittedBy", fields: [submittedForReviewById], references: [id], onDelete: SetNull)
  reviewedBy         User?       @relation("ArticleReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy         User?       @relation("ArticleApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy         User?       @relation("ArticleRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  createdBy          User?       @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?       @relation("ArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  histories ArticleHistory[]

  @@index([status])
  @@index([scheduledAt])
  @@index([publishedAt])
  @@index([subcategoryId, status])
  @@map("articles")
}

model ArticleHistory {
