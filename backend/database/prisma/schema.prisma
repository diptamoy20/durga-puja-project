// ---------------------------------------------------------------------------
// Durga Puja Global Connect - Prisma schema
//
// Ported from the Laravel 11 / MySQL schema (36 migrations, 31 tables).
// All services share this one schema and the generated client, which keeps
// cross-domain foreign keys intact.
//
// Deliberate changes from the MySQL original:
//  - `users.role` (string) and `users.permissions` (JSON) are dropped. They
//    were denormalised caches kept in sync with the pivot tables by a trait;
//    roles now live only in UserRole, permissions only in RolePermission.
//  - `users.department` (string) becomes a real FK to Department.
//  - `articles.category_id` pointed at `subcategories`, which made every query
//    misleading; renamed to `subcategoryId`.
//  - `albums.is_public` + `is_private` (which could contradict) collapse to
//    a single `isPublic`.
//  - Laravel's infrastructure tables (sessions, cache, jobs, failed_jobs) are
//    not ported: auth is stateless JWT, so RefreshToken replaces sessions.
//  - MySQL VARCHAR status columns become PostgreSQL enums.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum DiasporaStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CommitteeStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}

enum AssociationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}

enum ArticleStatus {
  DRAFT
  PENDING_REVIEW
  IN_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum InvestmentOpportunityStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaType {
  PHOTO
  VIDEO
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  SKIPPED
}

enum AiModerationStatus {
  PENDING
  PASSED
  FLAGGED
  FAILED
  SKIPPED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

enum AtlasStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum WebinarStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum RsvpStatus {
  REGISTERED
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ===========================================================================
// Identity & Access
// ===========================================================================

model Department {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(150)
  code        String       @unique @db.VarChar(50)
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  users User[]

  @@map("departments")
}

model User {
  id         Int     @id @default(autoincrement())
  firstName  String? @map("first_name") @db.VarChar(100)
  lastName   String? @map("last_name") @db.VarChar(100)
  name       String? @db.VarChar(200)
  employeeId String? @unique @map("employee_id") @db.VarChar(50)
  username   String? @unique @db.VarChar(100)
  email      String  @unique @db.VarChar(180)
  phone      String? @db.VarChar(25)

  departmentId Int?    @map("department_id")
  country      String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  city         String? @db.VarChar(100)
  address      String? @db.Text
  profileImage String? @map("profile_image") @db.VarChar(500)

  status   UserStatus @default(PENDING)
  password String     @db.VarChar(255)

  /// Encrypted generated password, so an admin can re-send the credentials for
  /// a provisioned portal account (the old `initial_password` column).
  initialPassword    String?  @map("initial_password") @db.Text
  mustChangePassword Boolean  @default(false) @map("must_change_password")

  emailVerified       Boolean   @default(false) @map("email_verified")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdById Int?      @map("created_by")
  updatedById Int?      @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?       @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  roles                UserRole[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  assignedRoles        UserRole[]           @relation("UserRoleAssignedBy")
  createdRoles         Role[]               @relation("RoleCreatedBy")
  updatedRoles         Role[]               @relation("RoleUpdatedBy")
  notifications        NotificationLog[]

  // Registration domain
  diasporaRegistration DiasporaRegistration? @relation("DiasporaAccount")
  verifiedDiaspora     DiasporaRegistration[] @relation("DiasporaVerifiedBy")
  rejectedDiaspora     DiasporaRegistration[] @relation("DiasporaRejectedBy")
  diasporaHistories    DiasporaVerificationHistory[] @relation("DiasporaHistoryChangedBy")
  pujaCommittee        PujaCommittee?        @relation("CommitteeAccount")
  approvedCommittees   PujaCommittee[]       @relation("CommitteeApprovedBy")
  rejectedCommittees   PujaCommittee[]       @relation("CommitteeRejectedBy")
  reviewedCommittees   PujaCommittee[]       @relation("CommitteeReviewedBy")
  committeeHistories   PujaCommitteeStatusHistory[] @relation("CommitteeHistoryChangedBy")

  // Content domain
  authoredArticles    Article[]        @relation("ArticleAuthor")
  submittedArticles   Article[]        @relation("ArticleSubmittedBy")
  reviewedArticles    Article[]        @relation("ArticleReviewedBy")
  approvedArticles    Article[]        @relation("ArticleApprovedBy")
  rejectedArticles    Article[]        @relation("ArticleRejectedBy")
  createdArticles     Article[]        @relation("ArticleCreatedBy")
  updatedArticles     Article[]        @relation("ArticleUpdatedBy")
  articleHistories    ArticleHistory[]
  uploadedMedia       Media[]

  // Gallery domain
  uploadedCommitteeMedia CommitteeMedia[] @relation("CommitteeMediaUploadedBy")
  moderatedCommitteeMedia CommitteeMedia[] @relation("CommitteeMediaModeratedBy")

  // Atlas domain
  ownedPandals    PandalAtlas[] @relation("PandalOwner")
  reviewedPandals PandalAtlas[] @relation("PandalReviewedBy")
  approvedPandals PandalAtlas[] @relation("PandalApprovedBy")
  createdPandals  PandalAtlas[] @relation("PandalCreatedBy")
  updatedPandals  PandalAtlas[] @relation("PandalUpdatedBy")

  // Events domain
  createdWebinars     Webinar[]              @relation("WebinarCreatedBy")
  updatedWebinars     Webinar[]              @relation("WebinarUpdatedBy")
  webinarRegistrations WebinarRegistration[]

  // Podcast domain
  createdPodcasts     PodcastEpisode[]       @relation("PodcastCreatedBy")
  updatedPodcasts     PodcastEpisode[]       @relation("PodcastUpdatedBy")

  // Tourism domain
  assignedEnquiries   TourismEnquiry[]       @relation("TourismEnquiryAssignedTo")
  enquiryHistories    TourismEnquiryHistory[]

  // Investor Showcase domain
  submittedInvestments InvestmentOpportunity[] @relation("InvestmentSubmittedBy")
  approvedInvestments  InvestmentOpportunity[] @relation("InvestmentApprovedBy")
  rejectedInvestments  InvestmentOpportunity[] @relation("InvestmentRejectedBy")
  publishedInvestments InvestmentOpportunity[] @relation("InvestmentPublishedBy")
  createdInvestments   InvestmentOpportunity[] @relation("InvestmentCreatedBy")
  updatedInvestments   InvestmentOpportunity[] @relation("InvestmentUpdatedBy")
  investmentHistories  InvestmentOpportunityHistory[]
  assignedInvestmentEnquiries InvestmentEnquiry[] @relation("InvestmentEnquiryAssignedTo")
  investmentEnquiryHistories  InvestmentEnquiryHistory[]

  // Association domain
  association         Association? @relation("AssociationAccount")
  approvedAssociations Association[] @relation("AssociationApprovedBy")
  rejectedAssociations Association[] @relation("AssociationRejectedBy")
  reviewedAssociations Association[] @relation("AssociationReviewedBy")
  associationHistories AssociationStatusHistory[] @relation("AssociationHistoryChangedBy")

  // Sharad Samman domain
  reviewedNominations    SharadSammanNomination[] @relation("NominationReviewedBy")
  approvedNominations    SharadSammanNomination[] @relation("NominationApprovedBy")
  rejectedNominations    SharadSammanNomination[] @relation("NominationRejectedBy")
  shortlistedNominations SharadSammanNomination[] @relation("NominationShortlistedBy")
  createdNominations     SharadSammanNomination[] @relation("NominationCreatedBy")
  reviewedVotes          SharadSammanVote[]       @relation("VoteReviewedBy")

  @@index([status])
  @@index([createdAt])
  @@index([departmentId])
  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(150)
  slug        String       @unique @db.VarChar(150)
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)

  /// Guards the seeded system roles (e.g. Super Admin) against deletion.
  isSystem Boolean @default(false) @map("is_system")

  createdById Int?      @map("created_by")
  updatedById Int?      @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy User? @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  permissions RolePermission[]
  users       UserRole[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id             Int          @id @default(autoincrement())
  module         String       @db.VarChar(100)
  permissionName String       @map("permission_name") @db.VarChar(150)
  permissionKey  String       @unique @map("permission_key") @db.VarChar(150)
  description    String?      @db.Text
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  roles RolePermission[]

  @@index([module, status])
  @@map("permissions")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  roleId       Int      @map("role_id")
  assignedById Int?     @map("assigned_by")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditLog {
  id     Int    @id @default(autoincrement())
  userId Int?   @map("user_id")
  action String @db.VarChar(100)
  module String @db.VarChar(100)

  /// Polymorphic target carried over from Laravel's morphTo(). Not a foreign
  /// key because it can point at any domain table.
  auditableType String? @map("auditable_type") @db.VarChar(150)
  auditableId   Int?    @map("auditable_id")

  description String? @db.Text
  oldValues   Json?   @map("old_values")
  newValues   Json?   @map("new_values")
  ipAddress   String? @map("ip_address") @db.VarChar(45)
  userAgent   String? @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, action])
  @@index([auditableType, auditableId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

/// Refresh tokens are stored hashed so a database leak cannot be replayed.
/// These rows are the revocation list that stateless JWTs otherwise lack.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  email     String    @db.VarChar(180)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

// ===========================================================================
// Taxonomy (categories / subcategories)
// ===========================================================================

model Category {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(150)
  slug        String       @unique @db.VarChar(150)
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  subcategories  Subcategory[]
  committeeMedia CommitteeMedia[]
  albums         Album[]

  @@index([status])
  @@index([name])
  @@map("categories")
}

model Subcategory {
  id          Int          @id @default(autoincrement())
  categoryId  Int          @map("category_id")
  name        String       @db.VarChar(150)
  slug        String       @db.VarChar(150)
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  articles       Article[]
  committeeMedia CommitteeMedia[]
  albums         Album[]

  /// Slug is unique within its parent category, not globally.
  @@unique([categoryId, slug])
  @@index([status])
  @@index([name])
  @@map("subcategories")
}

// ===========================================================================
// Registration & Onboarding
// ===========================================================================

model DiasporaRegistration {
  id Int @id @default(autoincrement())

  /// Set once the application is verified and a portal account is provisioned.
  userId Int? @unique @map("user_id")

  registrationNo String   @unique @map("registration_no") @db.VarChar(50)
  fullName       String   @map("full_name") @db.VarChar(200)
  dob            DateTime @db.Date
  gender         String   @db.VarChar(30)
  email          String   @unique @db.VarChar(180)
  mobile         String   @db.VarChar(25)

  /// `country_id` / `state_id` in the original were VARCHAR holding names, not
  /// foreign keys, so they are renamed to stop them reading like references.
  country                String  @db.VarChar(100)
  city                   String  @db.VarChar(100)
  passportNo             String? @map("passport_no") @db.VarChar(100)
  nationality            String  @db.VarChar(100)
  address1               String  @db.VarChar(255)
  address2               String? @db.VarChar(255)
  state                  String? @db.VarChar(100)
  postalCode             String? @map("postal_code") @db.VarChar(20)
  districtOrigin         String  @map("district_origin") @db.VarChar(100)
  village                String? @db.VarChar(100)
  relationshipWithBengal String  @map("relationship_with_bengal") @db.VarChar(100)
  languages              String? @db.VarChar(255)
  interests              Json?

  volunteer      Boolean @default(false)
  receiveUpdates  Boolean @default(false) @map("receive_updates")
  termsAccepted   Boolean @map("terms_accepted")

  status          DiasporaStatus @default(PENDING)
  verifiedById    Int?           @map("verified_by")
  verifiedAt      DateTime?      @map("verified_at")
  rejectedById    Int?           @map("rejected_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User? @relation("DiasporaAccount", fields: [userId], references: [id], onDelete: SetNull)
  verifiedBy User? @relation("DiasporaVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("DiasporaRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  histories DiasporaVerificationHistory[]

  @@index([status, createdAt])
  @@index([country])
  @@map("diaspora_registrations")
}

model DiasporaVerificationHistory {
  id                     Int      @id @default(autoincrement())
  diasporaRegistrationId Int      @map("diaspora_registration_id")
  previousStatus         String?  @map("previous_status") @db.VarChar(30)
  newStatus              String   @map("new_status") @db.VarChar(30)
  action                 String   @db.VarChar(30)
  reason                 String?  @db.Text
  changedById            Int?     @map("changed_by")
  createdAt              DateTime @default(now()) @map("created_at")

  registration DiasporaRegistration @relation(fields: [diasporaRegistrationId], references: [id], onDelete: Cascade)
  changedBy    User?                @relation("DiasporaHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([diasporaRegistrationId, createdAt])
  @@map("diaspora_verification_histories")
}

model PujaCommittee {
  id     Int  @id @default(autoincrement())
  userId Int? @unique @map("user_id")

  registrationNo String @unique @map("registration_no") @db.VarChar(50)

  /// Human-facing committee code, issued on approval.
  committeeId String? @unique @map("committee_id") @db.VarChar(30)

  committeeName        String @map("committee_name") @db.VarChar(200)
  establishedYear      Int    @map("established_year") @db.SmallInt
  pujaType             String @map("puja_type") @db.VarChar(60)
  pujaCategory         String @map("puja_category") @db.VarChar(100)
  committeeDescription String @map("committee_description") @db.Text

  contactPersonName String @map("contact_person_name") @db.VarChar(200)
  designation       String @db.VarChar(100)
  email             String @db.VarChar(180)
  mobile            String @db.VarChar(25)

  country    String @db.VarChar(100)
  state      String @db.VarChar(100)
  city       String @db.VarChar(100)
  postalCode String @map("postal_code") @db.VarChar(20)

  venueName    String  @map("venue_name") @db.VarChar(180)
  venueAddress String  @map("venue_address") @db.VarChar(255)
  landmark     String? @db.VarChar(255)
  address      String  @db.Text

  /// Uploaded document paths, relative to the configured upload root.
  registrationCertificate String  @map("registration_certificate") @db.VarChar(500)
  addressProof            String  @map("address_proof") @db.VarChar(500)
  pandalImage             String  @map("pandal_image") @db.VarChar(500)
  declaration             Boolean

  status          CommitteeStatus @default(PENDING)
  approvedById    Int?            @map("approved_by")
  approvedAt      DateTime?       @map("approved_at")
  rejectedById    Int?            @map("rejected_by")
  rejectedAt      DateTime?       @map("rejected_at")
  rejectionReason String?         @map("rejection_reason") @db.Text
  reviewedById    Int?            @map("reviewed_by")
  reviewedAt      DateTime?       @map("reviewed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user       User? @relation("CommitteeAccount", fields: [userId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("CommitteeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("CommitteeRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("CommitteeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  histories      PujaCommitteeStatusHistory[]
  committeeMedia CommitteeMedia[]
  albums         Album[]
  pandals        PandalAtlas[]
  nominations    SharadSammanNomination[]

  @@index([status, createdAt])
  @@index([city])
  @@map("puja_committees")
}

model PujaCommitteeStatusHistory {
  id              Int      @id @default(autoincrement())
  pujaCommitteeId Int      @map("puja_committee_id")
  previousStatus  String?  @map("previous_status") @db.VarChar(30)
  newStatus       String   @map("new_status") @db.VarChar(30)
  reason          String?  @db.Text
  changedById     Int?     @map("changed_by")
  createdAt       DateTime @default(now()) @map("created_at")

  committee PujaCommittee @relation(fields: [pujaCommitteeId], references: [id], onDelete: Cascade)
  changedBy User?         @relation("CommitteeHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([pujaCommitteeId, createdAt])
  @@map("puja_committee_status_histories")
}

model Association {
  id          Int    @id @default(autoincrement())
  userId      Int?   @unique @map("user_id")
  registrationNo String @unique @map("registration_no") @db.VarChar(50)
  associationId String? @unique @map("association_id") @db.VarChar(30)

  name        String @db.VarChar(200)
  description String @db.Text
  establishedYear Int? @map("established_year") @db.SmallInt

  contactPersonName String @map("contact_person_name") @db.VarChar(200)
  designation       String @db.VarChar(100)
  email             String @db.VarChar(180)
  mobile            String @db.VarChar(25)
  website           String? @db.VarChar(500)
  socialLinks       Json?

  country    String @db.VarChar(100)
  state      String @db.VarChar(100)
  city       String @db.VarChar(100)
  postalCode String @map("postal_code") @db.VarChar(20)
  address    String @db.Text

  logoImage  String? @map("logo_image") @db.VarChar(500)
  coverImage String? @map("cover_image") @db.VarChar(500)

  status          AssociationStatus @default(PENDING)
  approvedById    Int?            @map("approved_by")
  approvedAt      DateTime?       @map("approved_at")
  rejectedById    Int?            @map("rejected_by")
  rejectedAt      DateTime?       @map("rejected_at")
  rejectionReason String?         @map("rejection_reason") @db.Text
  reviewedById    Int?            @map("reviewed_by")
  reviewedAt      DateTime?       @map("reviewed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user       User? @relation("AssociationAccount", fields: [userId], references: [id], onDelete: SetNull)
  approvedBy User? @relation("AssociationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("AssociationRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("AssociationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  histories AssociationStatusHistory[]
  subscribers AssociationSubscriber[]

  @@index([status, createdAt])
  @@index([city])
  @@map("associations")
}

model AssociationStatusHistory {
  id             Int      @id @default(autoincrement())
  associationId  Int      @map("association_id")
  previousStatus String?  @map("previous_status") @db.VarChar(30)
  newStatus      String   @map("new_status") @db.VarChar(30)
  reason         String?  @db.Text
  changedById    Int?     @map("changed_by")
  createdAt      DateTime @default(now()) @map("created_at")

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  changedBy   User?         @relation("AssociationHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([associationId, createdAt])
