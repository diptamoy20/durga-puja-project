// Gallery (committee media & albums)
// ===========================================================================

model CommitteeMedia {
  id              Int  @id @default(autoincrement())
  pujaCommitteeId Int  @map("puja_committee_id")
  categoryId      Int? @map("category_id")
  subcategoryId   Int? @map("subcategory_id")
  uploadedById    Int  @map("uploaded_by")

  mediaType   MediaType @map("media_type")
  title       String?   @db.VarChar(255)
  description String?   @db.Text
  venueName   String?   @map("venue_name") @db.VarChar(255)

  originalFilename String @map("original_filename") @db.VarChar(255)
  storedPath       String @map("stored_path") @db.VarChar(500)
  thumbnailPath    String? @map("thumbnail_path") @db.VarChar(500)
  mimeType         String @map("mime_type") @db.VarChar(120)
  fileSize         BigInt @map("file_size")

  status          MediaModerationStatus @default(PENDING)
  rejectionReason String?               @map("rejection_reason") @db.Text
  moderatedById   Int?                  @map("moderated_by")
  moderatedAt     DateTime?             @map("moderated_at")

  /// Moderation pipeline: virus scan -> AI moderation -> admin approval.
  virusScanStatus    VirusScanStatus    @default(PENDING) @map("virus_scan_status")
  virusScanResult    Json?              @map("virus_scan_result")
  aiModerationStatus AiModerationStatus @default(PENDING) @map("ai_moderation_status")
  aiModerationResult Json?              @map("ai_moderation_result")
  processingStatus   ProcessingStatus   @default(PENDING) @map("processing_status")
  processingError    String?            @map("processing_error") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  committee   PujaCommittee @relation(fields: [pujaCommitteeId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  uploadedBy  User          @relation("CommitteeMediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  moderatedBy User?         @relation("CommitteeMediaModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  albums AlbumMedia[]

  @@index([status, mediaType])
  @@index([pujaCommitteeId, status])
  @@index([venueName])
  @@index([createdAt])
  @@index([categoryId, subcategoryId])
  @@map("committee_media")
}

model Album {
