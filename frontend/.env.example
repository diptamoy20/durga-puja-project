# ---------------------------------------------------------------------------
# Frontend configuration
#
#   cd frontend
#   copy .env.example .env
#
# Only VITE_-prefixed variables reach the browser, and everything here is
# baked into the built bundle. Never put a secret in this file: no database
# credentials, no JWT secret, no private API keys, and no internal
# microservice ports. The API Gateway URL is all the client needs.
# ---------------------------------------------------------------------------

# The gateway serves /api/v1. It defaults to port 5050 because PostgreSQL
# already occupies 5000 on this machine; keep this in step with GATEWAY_PORT
# in backend/.env.
VITE_API_URL=http://localhost:5050/api/v1

VITE_APP_NAME="Durga Puja Global Connect"

# Vite dev server port.
WEB_PORT=5173
